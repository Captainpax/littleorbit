LITTLE_ORBIT_ENV=development
PUBLIC_BASE_URL=http://localhost:8180
RELEASE_STORAGE_DIR=data/releases
DATABASE_URL=postgresql+asyncpg://little_orbit_api:change-me-api@postgres:5432/little_orbit
DATABASE_OWNER_URL=postgresql+asyncpg://little_orbit:change-me@postgres:5432/little_orbit
DATABASE_API_URL=postgresql+asyncpg://little_orbit_api:change-me-api@postgres:5432/little_orbit
DATABASE_WORKER_URL=postgresql+asyncpg://little_orbit_worker:change-me-worker@postgres:5432/little_orbit
DATABASE_MEDIA_URL=postgresql+asyncpg://little_orbit_media:change-me-media@postgres:5432/little_orbit
POSTGRES_DB=little_orbit
POSTGRES_USER=little_orbit
POSTGRES_PASSWORD=change-me
POSTGRES_API_PASSWORD=change-me-api
POSTGRES_WORKER_PASSWORD=change-me-worker
POSTGRES_MEDIA_PASSWORD=change-me-media
POSTGRES_BACKUP_PASSWORD=change-me-backup
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_PEPPER=replace-with-a-different-random-secret
SESSION_MINUTES=43200
ADMIN_SESSION_MINUTES=30
TOTP_ENCRYPTION_KEY=replace-with-a-fernet-key
OUTBOX_ENCRYPTION_KEY=replace-with-a-different-fernet-key
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-a-third-fernet-key
# Optional content-free FCM wakes. Keep the service-account JSON outside Git.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Absolute host path to the Firebase service-account JSON; use compose.push.yaml.
FCM_SERVICE_ACCOUNT_FILE=
LITTLE_ORBIT_FIREBASE_APPLICATION_ID=
LITTLE_ORBIT_FIREBASE_API_KEY=
LITTLE_ORBIT_FIREBASE_PROJECT_ID=
LITTLE_ORBIT_FIREBASE_SENDER_ID=
BACKUP_AGE_RECIPIENT=age1replace-with-the-public-recipient-from-age-keygen
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=hello@lil-orb.pax-kun.com
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MODEL_DIGEST=0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0
# Immediate Caddy-to-API peer; Compose assigns this fixed gateway-api address.
TRUSTED_PROXY_IP=172.30.14.2
REGISTRATION_OPEN=true
GITHUB_REPOSITORY_URL=https://github.com/Captainpax/littleorbit
APK_RELEASE_URL=https://github.com/OWNER/little-orbit/releases
