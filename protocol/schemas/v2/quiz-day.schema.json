{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lil-orb.pax-kun.com/protocol/v2/quiz-day.schema.json",
  "title": "Privacy-aware shared quiz day",
  "type": "object",
  "additionalProperties": false,
  "required": ["quiz_date", "status", "revision", "my_finished", "partner_finished", "revealed", "editable", "questions"],
  "properties": {
    "quiz_date": {"type": "string", "format": "date"},
    "status": {"enum": ["not_started", "in_progress", "waiting", "revealed", "expired"]},
    "revision": {"type": "integer", "minimum": 0},
    "my_finished": {"type": "boolean"},
    "partner_finished": {"type": "boolean"},
    "revealed": {"type": "boolean"},
    "editable": {"type": "boolean"},
    "questions": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "option": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "icon_key"],
      "properties": {"id": {"pattern": "^o[1-6]$"}, "label": {"type": "string", "minLength": 1, "maxLength": 80}, "icon_key": {"type": "string"}}
    },
    "answer": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "selected_option_id"], "properties": {"kind": {"const": "single_choice"}, "selected_option_id": {"pattern": "^o[1-6]$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "selected_option_ids"], "properties": {"kind": {"const": "multiple_choice"}, "selected_option_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^o[1-6]$"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "free_text"}, "text": {"type": "string", "minLength": 1, "maxLength": 1000}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "self_option_id", "guess_option_id"], "properties": {"kind": {"const": "partner_guess"}, "self_option_id": {"pattern": "^o[1-6]$"}, "guess_option_id": {"pattern": "^o[1-6]$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "ratings"], "properties": {"kind": {"const": "weighted_choice"}, "ratings": {"type": "object", "minProperties": 2, "maxProperties": 6, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}}}}
      ]
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "position", "interaction_version", "kind", "prompt", "category", "intimacy", "options", "scale_low_label", "scale_high_label", "my_answer", "my_answer_revision", "partner_answer"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "position": {"type": "integer", "minimum": 1, "maximum": 5},
        "interaction_version": {"const": 2}, "kind": {"enum": ["single_choice", "multiple_choice", "free_text", "partner_guess", "weighted_choice"]},
        "prompt": {"type": "string", "minLength": 12, "maxLength": 240}, "category": {"type": "string"}, "intimacy": {"type": "boolean"},
        "options": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/option"}},
        "scale_low_label": {"type": ["string", "null"]}, "scale_high_label": {"type": ["string", "null"]},
        "my_answer": {"anyOf": [{"$ref": "#/$defs/answer"}, {"type": "null"}]}, "my_answer_revision": {"type": "integer", "minimum": 0},
        "partner_answer": {"anyOf": [{"$ref": "#/$defs/answer"}, {"type": "null"}]}
      }
    }
  }
}
