{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lil-orb.pax-kun.com/protocol/v1/question-batch.schema.json",
  "title": "Generated question batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "questions"],
  "properties": {
    "schema_version": { "const": "1" },
    "date": { "type": "string", "format": "date" },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "kind", "prompt", "category", "intimacy", "options"],
      "properties": {
        "client_id": { "type": "string", "pattern": "^[a-z0-9-]{3,48}$" },
        "kind": { "enum": ["single_choice", "multiple_choice", "free_text", "partner_guess", "weighted_scale"] },
        "prompt": { "type": "string", "minLength": 12, "maxLength": 240 },
        "category": { "enum": ["everyday", "memories", "dreams", "values", "playful", "connection", "intimacy"] },
        "intimacy": { "type": "boolean" },
        "options": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["single_choice", "multiple_choice", "partner_guess"] } } },
          "then": { "properties": { "options": { "minItems": 2 } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["free_text", "weighted_scale"] } } },
          "then": { "properties": { "options": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "category": { "const": "intimacy" } } },
          "then": { "properties": { "intimacy": { "const": true } } }
        }
      ]
    }
  }
}
