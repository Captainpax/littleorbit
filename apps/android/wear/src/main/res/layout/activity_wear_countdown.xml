<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_boxedEdges="all">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="@string/countdown_eyebrow" android:textColor="#CEC7FF" android:textSize="11sp" />
            <TextView android:id="@+id/countdownTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:maxLines="2" android:textColor="#F7F6FF" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/countdownRemaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="#FFC45B" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:id="@+id/countdownWhen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#AEBBD2" android:textSize="12sp" />
            <TextView android:id="@+id/countdownFreshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#AEBBD2" android:textSize="11sp" />
            <Button android:id="@+id/countdownTogether" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:text="@string/open_together" android:textAllCaps="false" />
            <Button android:id="@+id/countdownSmooch" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/open_smooch" android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
