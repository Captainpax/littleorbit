<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:src="@drawable/wear_icon" />

    <TextView
        android:id="@+id/wearStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/together_for"
        android:textColor="#AEB5C9"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/wearTogether"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unavailable"
        android:textColor="#F8F5FF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/open_phone_to_refresh"
        android:textColor="#F5C86C"
        android:textSize="11sp" />
</LinearLayout>
