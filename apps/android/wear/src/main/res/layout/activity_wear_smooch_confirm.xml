<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" app:layout_boxedEdges="all">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/confirmEmoji" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="44sp" />
            <TextView android:id="@+id/confirmPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#F7F6FF" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/confirmStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/smooch_expiry" android:textColor="#AEBBD2" android:textSize="11sp" />
            <Button android:id="@+id/confirmSmooch" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="@string/send_smooch" android:textAllCaps="false" />
            <Button android:id="@+id/cancelSmooch" android:layout_width="match_parent" android:layout_height="42dp" android:text="@string/cancel" android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
