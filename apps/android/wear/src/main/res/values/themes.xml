<resources>
    <style name="Theme.LittleOrbit.Wear" parent="android:style/Theme.DeviceDefault">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">#050C1A</item>
        <item name="android:colorAccent">#A89BFF</item>
        <item name="android:navigationBarColor">#050C1A</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="WearEmojiButton" parent="android:style/Widget.DeviceDefault.Button">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="WearDestinationButton" parent="android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/wear_secondary</item>
        <item name="android:textColor">#F7F6FF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="WearPrimaryButton" parent="android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/wear_primary</item>
        <item name="android:textColor">#071024</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
