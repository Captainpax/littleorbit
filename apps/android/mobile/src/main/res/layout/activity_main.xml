<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_cosmic"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_tagline"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />

                <LinearLayout
                    android:id="@+id/updateBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/card_background_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/planet_lavender"
                        android:gravity="center"
                        android:text="↓"
                        android:textColor="@color/navy_deep"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_available"
                            android:textColor="@color/cloud"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/updateBannerText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="›"
                        android:textColor="@color/lavender_soft"
                        android:textSize="28sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/planet_lavender"
                        android:contentDescription="@string/your_planet"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="@color/cloud"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="8dp"
                        android:gravity="center"
                        android:text="✦"
                        android:textColor="@color/amber"
                        android:textSize="32sp" />
                    <TextView
                        android:id="@+id/partnerPlanet"
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/planet_coral"
                        android:contentDescription="@string/partner_planet"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="@color/cloud"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="Welcome to your orbit"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Title"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:text="@string/connect_intro"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />

                <LinearLayout
                    android:id="@+id/sharedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/togetherButton"
                        style="@style/Widget.LittleOrbit.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:gravity="center_vertical|start"
                        android:text="@string/together_details" />
                    <TextView
                        android:id="@+id/togetherText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="-46dp"
                        android:layout_marginBottom="26dp"
                        android:importantForAccessibility="no"
                        android:text="Not connected"
                        android:textColor="@color/cloud"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/countdownsButton"
                        style="@style/Widget.LittleOrbit.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:gravity="center_vertical|start"
                        android:text="@string/countdown_label" />
                    <TextView
                        android:id="@+id/countdownText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="-46dp"
                        android:layout_marginBottom="26dp"
                        android:importantForAccessibility="no"
                        android:text="No countdown yet"
                        android:textColor="@color/cloud"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quizButton"
                        style="@style/Widget.LittleOrbit.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:gravity="center_vertical|start"
                        android:text="@string/today_quiz_card" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notesButton"
                        style="@style/Widget.LittleOrbit.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:gravity="center_vertical|start"
                        android:text="@string/note_card" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/memberActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pairingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_partner" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/guestActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/signInButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sign_in" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/createAccountButton"
                        style="@style/Widget.LittleOrbit.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/create_account" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/moreScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/more"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/more_intro"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/moreCountdownsButton"
                    style="@style/Widget.LittleOrbit.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/countdowns" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/morePairingButton"
                    style="@style/Widget.LittleOrbit.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/moreTogetherButton"
                    style="@style/Widget.LittleOrbit.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/together_details" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacyButton"
                    style="@style/Widget.LittleOrbit.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_controls" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/archivesButton"
                    style="@style/Widget.LittleOrbit.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/past_archives" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/appUpdatesButton"
                    style="@style/Widget.LittleOrbit.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_updates" />
                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/muted" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wear_update_guidance"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signOutButton"
                    style="@style/Widget.LittleOrbit.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/sign_out" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bottom_nav_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeNav"
            style="@style/Widget.LittleOrbit.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/home" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/quizNav"
            style="@style/Widget.LittleOrbit.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/quiz" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/notesNav"
            style="@style/Widget.LittleOrbit.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/notes" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/moreNav"
            style="@style/Widget.LittleOrbit.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/more" />
    </LinearLayout>
</LinearLayout>
