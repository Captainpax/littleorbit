<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/countdownScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/background_cosmic" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/newButton" style="@style/Widget.LittleOrbit.Button.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/new_countdown" />
        <LinearLayout android:id="@+id/heroCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/quiz_card_background" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.18" android:text="@string/next_up" android:textAllCaps="true" android:textColor="@color/lavender" android:textStyle="bold" />
            <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/cloud" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/heroRemaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/lavender_soft" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/heroDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/addHeroToCalendar" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_to_calendar" />
                <com.google.android.material.button.MaterialButton android:id="@+id/editHero" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/edit" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/card_background_muted" android:gravity="center" android:minHeight="96dp" android:padding="20dp" android:text="@string/no_countdowns" android:textAppearance="@style/TextAppearance.LittleOrbit.Body" android:visibility="gone" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:textColor="@color/lavender" />
        <TextView android:id="@+id/upcomingLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:letterSpacing="0.18" android:text="@string/upcoming" android:textAllCaps="true" android:textColor="@color/lavender" android:textStyle="bold" android:visibility="gone" />
        <LinearLayout android:id="@+id/upcomingContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pastToggle" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/show_past_moments" />
        <LinearLayout android:id="@+id/pastContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
