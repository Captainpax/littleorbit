<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_cosmic">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/archiveIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/archive_intro"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/archivePickerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:labelFor="@id/archivePicker"
            android:text="@string/visual_archive_picker_label"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Eyebrow" />

        <Spinner
            style="@style/Widget.LittleOrbit.Spinner"
            android:id="@+id/archivePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:prompt="@string/visual_archive_picker_label" />

        <TextView
            android:id="@+id/archiveHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:accessibilityHeading="true"
            android:textColor="@color/cloud"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/archiveDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted" />

        <LinearLayout
            android:id="@+id/archiveContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/lavender" />
    </LinearLayout>
</ScrollView>
