<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/background_cosmic" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/our_notes"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center" android:text="@string/notes_intro"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
        <TextView android:id="@+id/presenceText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="@drawable/card_background_muted" android:gravity="center"
            android:padding="12dp" android:text="@string/note_presence_solo"
            android:textColor="@color/lavender_soft" />

        <LinearLayout android:id="@+id/editorCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:background="@drawable/card_background_feature" android:orientation="vertical"
            android:padding="18dp">
            <EditText android:id="@+id/titleInput" style="@style/Widget.LittleOrbit.Input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/note_title" android:textColor="@color/cloud"
                android:textColorHint="@color/muted" android:textSize="22sp" android:textStyle="bold" />
            <EditText android:id="@+id/bodyInput" style="@style/Widget.LittleOrbit.Input"
                android:layout_width="match_parent" android:layout_height="280dp"
                android:layout_marginTop="10dp" android:gravity="top" android:hint="@string/note_body"
                android:inputType="textCapSentences|textMultiLine" android:textColor="@color/cloud"
                android:textColorHint="@color/muted" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite" android:textColor="@color/lavender" />
        </LinearLayout>

        <LinearLayout android:id="@+id/conflictCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/card_background" android:orientation="vertical"
            android:padding="14dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/partner_version" android:textAppearance="@style/TextAppearance.LittleOrbit.Eyebrow" />
            <TextView android:id="@+id/serverVersionText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/cloud" />
            <com.google.android.material.button.MaterialButton android:id="@+id/useServerButton"
                style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/use_server_version" />
            <com.google.android.material.button.MaterialButton android:id="@+id/keepMyVersionButton"
                style="@style/Widget.LittleOrbit.Button.Primary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/keep_my_version" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/syncButton"
            style="@style/Widget.LittleOrbit.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/save_now" />
        <com.google.android.material.button.MaterialButton android:id="@+id/archiveButton"
            style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/archive_note" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/all_notes"
            android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />
        <LinearLayout android:id="@+id/noteListContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/createButton"
            style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/create_new_note" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/recently_archived"
            android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/archive_undo_hint"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
        <LinearLayout android:id="@+id/archivedNotesContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
