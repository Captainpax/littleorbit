<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_cosmic">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/finish_setup"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_intro"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
        <TextView
            android:id="@+id/notificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/cloud"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationButton"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_notifications" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/notification_choices"
            android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/notification_choices_hint"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/all_partner_notifications" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationSmooches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/smooch_notifications" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/note_edit_notifications" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/quiz_notifications" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationCountdowns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/countdown_notifications" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationTogetherTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/together_time_notifications" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationWeekly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/weekly_smooch_summary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveNotificationPreferences"
            style="@style/Widget.LittleOrbit.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/save_notification_choices" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkNotifications"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_notifications_now" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openNotificationSettings"
            style="@style/Widget.LittleOrbit.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_android_notification_settings" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notification_diagnostics"
            android:textColor="@color/lavender_soft"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notificationDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
        <TextView
            android:id="@+id/locationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/cloud"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/locationButton"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_location" />
        <TextView
            android:id="@+id/wearStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/cloud"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wearButton"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/install_watch_app" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/done" />
    </LinearLayout>
</ScrollView>
