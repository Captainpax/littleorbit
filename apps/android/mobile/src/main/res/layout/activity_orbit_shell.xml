<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orbitDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_cosmic">

    <LinearLayout
        android:id="@+id/shellMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/orbitToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/navy_deep"
            android:elevation="0dp"
            android:paddingHorizontal="6dp"
            app:titleTextColor="@color/cloud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openLeftDrawer"
                    style="@style/Widget.LittleOrbit.Button.Text"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/open_navigation"
                    android:text=""
                    app:icon="@drawable/ic_menu"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <TextView
                    android:id="@+id/shellTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openRightDrawer"
                    style="@style/Widget.LittleOrbit.Button.Text"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/open_context_panel"
                    android:text=""
                    app:icon="@drawable/ic_context_panel"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <FrameLayout
            android:id="@+id/orbitContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/leftDrawer"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/navy_surface_muted"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />

            <com.google.android.material.button.MaterialButton android:id="@+id/navHome" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/home" app:icon="@drawable/ic_home" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navQuiz" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/quiz" app:icon="@drawable/ic_quiz" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navSmooch" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/smooches" app:icon="@drawable/ic_smooch" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navSpace" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/our_space" app:icon="@drawable/ic_notes" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navCountdowns" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/countdowns" app:icon="@drawable/ic_countdown" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navTogether" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/together_details" app:icon="@drawable/ic_nearby" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navProfile" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/profile_photo" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navSettings" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/settings" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navPrivacy" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/privacy_controls" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navUpdates" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/app_updates" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navSignIn" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/sign_in" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navCreateAccount" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/create_account" />
            <com.google.android.material.button.MaterialButton android:id="@+id/navAbout" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="start|center_vertical" android:text="@string/about_little_orbit" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/rightDrawer"
        android:layout_width="336dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/navy_surface_muted"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/contextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />

            <TextView
                android:id="@+id/contextDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />

            <LinearLayout
                android:id="@+id/contextActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
