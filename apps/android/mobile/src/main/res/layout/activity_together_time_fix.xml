<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_cosmic">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fix_counting"
            android:textAppearance="@style/TextAppearance.LittleOrbit.ScreenTitle" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fix_counting_explanation"
            android:textColor="@color/muted" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/shareDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/share_collection_health" />
        <TextView
            android:id="@+id/thisPhoneHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:textColor="@color/cloud" />
        <TextView
            android:id="@+id/partnerHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:text="@string/partner_diagnostics_private"
            android:textColor="@color/cloud" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/locationSettings"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/open_location_settings" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationSettings"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_notification_settings" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/batterySettings"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_battery_settings" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/lavender" />
    </LinearLayout>
</ScrollView>
