<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_cosmic"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background_feature"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_time_title"
                android:textAllCaps="true"
                android:textColor="@color/lavender_soft"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nearby_duration_placeholder"
                android:textColor="@color/cloud"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/collectionState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/loading"
                android:textColor="@color/mint" />

            <TextView
                android:id="@+id/evidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/adjustmentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/nearby_adjusted"
                android:textColor="@color/amber"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legacyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/nearby_legacy_explanation"
                android:textColor="@color/muted"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/nearby_history_title"
            android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />

        <TextView
            android:id="@+id/historyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/correct_estimate_title"
            android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />

        <Spinner
            android:id="@+id/dayPicker"
            style="@style/Widget.LittleOrbit.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/hoursInput"
            style="@style/Widget.LittleOrbit.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/correction_hours"
            android:importantForAutofill="no"
            android:inputType="number" />

        <EditText
            android:id="@+id/minutesInput"
            style="@style/Widget.LittleOrbit.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/correction_minutes"
            android:importantForAutofill="no"
            android:inputType="number" />

        <EditText
            android:id="@+id/reasonInput"
            style="@style/Widget.LittleOrbit.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/correction_reason"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/correctButton"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/apply_correction" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/lavender" />
    </LinearLayout>
</ScrollView>
