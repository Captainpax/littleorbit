<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/orbit_screen_padding_horizontal"
        android:paddingTop="@dimen/orbit_screen_padding_vertical"
        android:paddingEnd="@dimen/orbit_screen_padding_horizontal"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_updates_intro"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/navy_surface"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/orbit_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/installed_on_this_device"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Eyebrow" />

                <TextView
                    android:id="@+id/installedVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/signed_update_summary"
                    android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoUpdateDetection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="56dp"
            android:text="@string/auto_update_detection"
            android:textColor="@color/cloud" />

        <TextView
            android:id="@+id/lastUpdateCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkForUpdates"
            style="@style/Widget.LittleOrbit.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/check_for_updates"
            app:icon="@drawable/ic_update" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualDownload"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/manual_download" />
    </LinearLayout>
</ScrollView>
