<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/background_cosmic" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/watch_page_horizontal_padding"
        android:paddingTop="24dp" android:paddingEnd="@dimen/watch_page_horizontal_padding"
        android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/wear_installer_title" android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:letterSpacing="0.12"
            android:text="@string/wear_step_progress" android:textColor="@color/lavender"
            android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/wizardStep" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center"
            android:text="@string/wear_wizard_step_one" android:textAppearance="@style/TextAppearance.LittleOrbit.Eyebrow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/wear_installer_intro"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/card_background_feature"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/wear_step_one" android:textAppearance="@style/TextAppearance.LittleOrbit.Eyebrow" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/wear_pair_instructions"
                android:textColor="@color/cloud" android:textSize="16sp" />
            <EditText android:id="@+id/wearPairingCode" style="@style/Widget.LittleOrbit.Input"
                android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp"
                android:digits="0123456789" android:hint="@string/wear_pairing_code"
                android:imeOptions="flagNoPersonalizedLearning" android:importantForAutofill="no"
                android:inputType="number" android:maxLength="6" android:saveEnabled="false" />
            <TextView android:id="@+id/wearDiscoveryStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" android:text="@string/wear_searching"
                android:textColor="@color/amber" />
            <com.google.android.material.button.MaterialButton android:id="@+id/restartWearDiscovery"
                style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/wear_scan_again" />
            <com.google.android.material.button.MaterialButton android:id="@+id/showManualWear"
                style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/wear_manual_address" />
            <LinearLayout android:id="@+id/manualWearFields" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <EditText android:id="@+id/wearHost" style="@style/Widget.LittleOrbit.Input"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="@string/wear_host" android:importantForAutofill="no" android:inputType="textUri" />
                <EditText android:id="@+id/wearPairPort" style="@style/Widget.LittleOrbit.Input"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="@string/wear_pair_port" android:importantForAutofill="no" android:inputType="number" />
                <EditText android:id="@+id/wearConnectPort" style="@style/Widget.LittleOrbit.Input"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="@string/wear_connect_port" android:importantForAutofill="no" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/card_background"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/wear_install_stages" android:textAppearance="@style/TextAppearance.LittleOrbit.Eyebrow" />
            <ProgressBar android:id="@+id/wearInstallProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="14dp"
                android:importantForAccessibility="no" android:indeterminate="true" android:visibility="gone" />
            <TextView android:id="@+id/wearInstallStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite" android:gravity="center"
                android:text="@string/wear_ready_to_begin" android:textColor="@color/muted" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retryWearArtifact"
                style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/wear_retry_download" android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/installWearNow"
            style="@style/Widget.LittleOrbit.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="@string/install_watch_app" />
        <com.google.android.material.button.MaterialButton android:id="@+id/forgetWearKey"
            style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/forget_watch_authorization" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/wear_installer_privacy"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
    </LinearLayout>
</ScrollView>
