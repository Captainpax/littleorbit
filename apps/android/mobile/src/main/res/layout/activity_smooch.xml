<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/background_cosmic" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/smooches" android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/smooch_intro"
            android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
        <TextView android:id="@+id/selectedSmooch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:gravity="center" android:textColor="@color/cloud" android:textSize="28sp"
            android:textStyle="bold" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:columnCount="3" android:rowCount="3">
            <Button android:id="@+id/emoji0" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji1" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji2" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji3" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji4" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji5" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji6" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji7" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
            <Button android:id="@+id/emoji8" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:textSize="26sp" />
        </GridLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/sendSmoochButton"
            style="@style/Widget.LittleOrbit.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="@string/send_smooch" />
        <TextView android:id="@+id/smoochStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:gravity="center" android:textColor="@color/coral_soft"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/revealSmooches"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/smooch_lock_screen_setting"
            android:textColor="@color/cloud" />
        <TextView android:id="@+id/smoochWeekZone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:textColor="@color/muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/usePhoneTimezone"
            style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/smooch_use_phone_timezone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="30dp" android:text="@string/smooch_weekly_title"
            android:textAppearance="@style/TextAppearance.LittleOrbit.CardTitle" />
        <TextView android:id="@+id/weeklyHistory" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/card_background_feature" android:padding="18dp"
            android:textColor="@color/cloud" />
    </LinearLayout>
</ScrollView>
