<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_cosmic">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lavender"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/cloud"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            style="@style/Widget.LittleOrbit.Input"
            android:id="@+id/answerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="top"
            android:hint="@string/your_answer"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="120dp"
            android:textColor="@color/cloud"
            android:textColorHint="@color/muted" />

        <Spinner
            style="@style/Widget.LittleOrbit.Spinner"
            android:id="@+id/optionInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp" />

        <SeekBar
            android:id="@+id/ratingInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="4" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/lavender" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/submit_answer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next_question" />

        <EditText
            style="@style/Widget.LittleOrbit.Input"
            android:id="@+id/reportReasonInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="@string/report_reason"
            android:textColor="@color/cloud"
            android:textColorHint="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportButton"
            style="@style/Widget.LittleOrbit.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_question" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/create_custom_question"
            android:textColor="@color/cloud"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            style="@style/Widget.LittleOrbit.Input"
            android:id="@+id/customPromptInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_prompt"
            android:textColor="@color/cloud"
            android:textColorHint="@color/muted" />

        <Spinner
            style="@style/Widget.LittleOrbit.Spinner"
            android:id="@+id/customKindInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            style="@style/Widget.LittleOrbit.Spinner"
            android:id="@+id/customCategoryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            style="@style/Widget.LittleOrbit.Input"
            android:id="@+id/customOptionsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_options"
            android:textColor="@color/cloud"
            android:textColorHint="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/customCreateButton"
            style="@style/Widget.LittleOrbit.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_custom_question" />
    </LinearLayout>
</ScrollView>
