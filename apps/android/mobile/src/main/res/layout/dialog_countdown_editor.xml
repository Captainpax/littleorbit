<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/background_cosmic">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/editorHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/new_countdown" android:textAppearance="@style/TextAppearance.LittleOrbit.Title" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/titleLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="@string/countdown_title"><com.google.android.material.textfield.TextInputEditText android:id="@+id/titleInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/allDaySwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/all_day_event" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dateButton" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/timeButton" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/timezoneLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/timezone"><AutoCompleteTextView android:id="@+id/timezoneInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/timezone" android:inputType="text" /></com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/remind_me" android:textColor="@color/lavender" android:textStyle="bold" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/reminderChips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:selectionRequired="false" app:singleSelection="false">
            <com.google.android.material.chip.Chip android:id="@+id/remindAtTime" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/at_time" />
            <com.google.android.material.chip.Chip android:id="@+id/remindHour" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/one_hour" />
            <com.google.android.material.chip.Chip android:id="@+id/remindDay" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/one_day" />
            <com.google.android.material.chip.Chip android:id="@+id/remindWeek" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/one_week" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/optional_notes"><com.google.android.material.textfield.TextInputEditText android:id="@+id/notesInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000" android:minLines="2" /></com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/editorStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:textColor="@color/coral" />
        <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" style="@style/Widget.LittleOrbit.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/save_countdown" />
        <com.google.android.material.button.MaterialButton android:id="@+id/saveCalendarButton" style="@style/Widget.LittleOrbit.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_and_add_calendar" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/rc14_calendar_copy_note" android:textAppearance="@style/TextAppearance.LittleOrbit.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deleteButton" style="@style/Widget.LittleOrbit.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delete_selected_countdown" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
