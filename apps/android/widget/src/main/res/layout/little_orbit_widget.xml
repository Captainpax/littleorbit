<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LITTLE ORBIT" android:textColor="#A997FF" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_together" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Together-time unavailable" android:textColor="#FFF9F8" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Open Little Orbit to refresh" android:textColor="#B8C0D3" android:textSize="12sp" />
    <TextView android:id="@+id/widget_stale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="STALE" android:textColor="#F5C86C" android:textSize="9sp" android:textStyle="bold" />
</LinearLayout>
